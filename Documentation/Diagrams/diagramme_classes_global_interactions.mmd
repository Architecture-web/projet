classDiagram
    %% ========================================================
    %% DIAGRAMME DE CLASSES GLOBAL & INTERACTIONS INTER-SERVICES
    %% ========================================================

    namespace AuthService {
        class User {
            +UUID id
            +String email
            +String passwordHash
            +String firstName
            +String lastName
            +Boolean isActive
            +register()
            +validatePassword()
        }
        class Role {
            +Long id
            +String code
            +String description
        }
        class RefreshToken {
            +UUID id
            +String token
            +DateTime expiryDate
            +isExpired() Boolean
        }
    }

    namespace CourseService {
        class Course {
            +String id
            +String title
            +String instructorId
            +DifficultyLevel difficulty
            +Boolean isPublished
        }
        class Module {
            +String moduleId
            +String title
            +Integer orderIndex
        }
        class Lesson {
            +String lessonId
            +String title
            +LessonType type
            +String exerciseRefId
        }
        class UserProgress {
            +String id
            +String userId
            +String courseId
            +Integer completionPercentage
            +Boolean isCompleted
            +markCompleted(lessonId)
        }
    }

    namespace CodeExecutionService {
        class CodeSubmission {
            +UUID id
            +String userId
            +String exerciseId
            +String language
            +SubmissionStatus status
            +Integer executionTimeMs
            +evaluate()
        }
        class TestCase {
            +UUID id
            +String exerciseId
            +String inputData
            +String expectedOutput
            +Boolean isHidden
        }
    }

    namespace GamificationService {
        class UserProfileGamification {
            +UUID userId
            +Integer totalXP
            +Integer currentLevel
            +Integer globalRank
            +addXP(amount)
        }
        class Badge {
            +Long id
            +String codeName
            +String title
            +Integer requiredXP
        }
        class Certificate {
            +UUID id
            +UUID userId
            +String courseId
            +String certificateHash
            +verifyHash() Boolean
        }
    }

    namespace JobBoardService {
        class JobPosting {
            +String id
            +String recruiterId
            +String jobTitle
            +List~String~ requiredSkills
            +Integer minimumRequiredXP
        }
        class JobApplication {
            +String id
            +String jobPostingId
            +String candidateId
            +Integer matchingScore
            +ApplicationStatus status
        }
    }

    namespace CommunityService {
        class ForumThread {
            +String id
            +String exerciseId
            +String authorId
            +String title
            +Integer upvotesCount
        }
        class ThreadComment {
            +String id
            +String threadId
            +String authorId
            +String contentMarkdown
        }
        class PeerReviewSolution {
            +String id
            +String exerciseId
            +String authorId
            +String codeSnippet
            +String timeComplexity
        }
    }

    %% ========================================================
    %% RELATIONS INTERNES AUX MICROSERVICES
    %% ========================================================
    User "1" --> "*" RefreshToken : possede
    Course *-- Module : contient
    Module *-- Lesson : contient
    UserProgress ..> Course : suit

    %% ========================================================
    %% INTERACTIONS INTER-SERVICES ENTRE CLASSES (REST & EVENTS)
    %% ========================================================
    User ..> UserProfileGamification : REST_Init_Profil
    Course ..> User : REST_Verif_Instructeur
    CodeSubmission ..> TestCase : REST_Charge_Assertions
    CodeSubmission ..> UserProfileGamification : Event_CodePassed_CreditXP
    CodeSubmission ..> UserProgress : Event_CodePassed_ValideProgression
    CodeSubmission ..> PeerReviewSolution : Event_CodePassed_DebloqueSolution
    Certificate ..> Course : REST_RecupereTitreCertifie
    JobApplication ..> UserProfileGamification : REST_ValideBadgesCandidat
    Badge ..> JobApplication : Event_BadgeUnlocked_RecalculMatching
    ForumThread ..> User : REST_EnrichitAuteur
