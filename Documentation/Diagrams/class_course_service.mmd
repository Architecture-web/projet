classDiagram
    class Course {
        +String id
        +String title
        +String slug
        +String description
        +DifficultyLevel difficulty
        +String instructorId
        +Boolean isPublished
        +DateTime createdAt
        +addModule(module)
        +publish()
    }

    class Module {
        +String moduleId
        +String title
        +Integer orderIndex
        +List~Lesson~ lessons
    }

    class Lesson {
        +String lessonId
        +String title
        +LessonType type
        +String contentMarkdown
        +String videoUrl
        +Integer durationMinutes
        +String exerciseRefId
    }

    class UserProgress {
        +String id
        +String userId
        +String courseId
        +Integer completionPercentage
        +Boolean isCompleted
        +DateTime lastAccessedAt
        +List~String~ completedLessonIds
        +markLessonCompleted(lessonId)
        +recalculatePercentage()
    }

    Course *-- Module : contient
    Module *-- Lesson : structure
    UserProgress ..> Course : suit l'avancement
